# Public backend origin only. Next.js embeds this value at build time.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Never add API keys, database URLs, or other secrets to NEXT_PUBLIC_*.
# FinBoy's public WhatsApp business number (digits only), read when /ml is built so its button
# opens the chat from the first paint (docs/ad-journey-round/contract.md). Not a secret; blank
# locally, where the page asks the API for the number instead.
FINBOY_WHATSAPP_NUMBER=
