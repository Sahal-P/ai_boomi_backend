ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://finboy:finboy_local@127.0.0.1:5433/finboy
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Backend only. Copy credentials from ~/.config/finboy/secrets.env; never NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Set model IDs verified against official OpenAI docs before enabling each feature.
OPENAI_EXTRACTION_MODEL=
OPENAI_ASSISTANT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact callback URL registered with Google.
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CLOUD_PROJECT=
# URL-safe base64 encoded 32-byte Fernet key; never commit a real key.
TOKEN_ENCRYPTION_KEY=
# Must exactly match a CORS origin when configured (e.g. http://127.0.0.1:3000).
WEB_APP_URL=
# Optional ISO date, e.g. 2026-10-28; ignored in production.
DEMO_TODAY=
