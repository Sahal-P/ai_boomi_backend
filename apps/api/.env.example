ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://finboy:finboy_local@127.0.0.1:5433/finboy
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Backend only. Copy credentials from ~/.config/finboy/secrets.env; never NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Set model IDs verified against official OpenAI docs before enabling each feature.
OPENAI_EXTRACTION_MODEL=
OPENAI_ASSISTANT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
# WhatsApp payment screenshots; set only after verifying image input for the model.
OPENAI_VISION_MODEL=
# openai (default), groq or sarvam. Groq handles English/Hindi (Malayalam stays on OpenAI);
# sarvam handles all three.
SPEECH_TRANSCRIBE_PROVIDER=openai
GROQ_API_KEY=
# Must be whisper-large-v3-turbo, after a synthetic live capability check.
GROQ_TRANSCRIBE_MODEL=
# Sarvam AI (docs/malayalam-round/contract.md). Before any real household's audio, turn off
# training on your content and set Data retention → Model APIs → No retention in Sarvam's dashboard.
SARVAM_API_KEY=
# Must be saaras:v3: the live check found it writes spoken amounts as digits in all three languages.
SARVAM_STT_MODEL=
# gemini (default) or sarvam, for Malayalam spoken replies only.
MALAYALAM_TTS_PROVIDER=gemini
# Must be bulbul:v3 (v4 Flash has no Malayalam). The speaker is a Bulbul name chosen by listening.
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER_ML=
# Liquid AI d1-ultra (docs/triage-round/contract.md) sorts messages, questions and photos so sure,
# common ones are answered before OpenAI. Check Liquid's data terms before any real household's
# message reaches it.
LIQUID_API_KEY=
# Must be d1-ultra, after a synthetic live check and `pnpm eval:triage`.
LIQUID_DECISION_MODEL=
TRIAGE_ENABLED=false
# Only the languages that passed the gate.
TRIAGE_LANGUAGES=["en","hi","ml"]
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact callback URL registered with Google.
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CLOUD_PROJECT=
# URL-safe base64 encoded 32-byte Fernet key; never commit a real key.
TOKEN_ENCRYPTION_KEY=
# Must exactly match a CORS origin when configured (e.g. http://127.0.0.1:3000).
WEB_APP_URL=
# Optional ISO date, e.g. 2026-10-28; ignored in production.
DEMO_TODAY=
# Required in production. Generate a scrypt hash and independent Fernet session key privately.
HOUSEHOLD_PASSWORD_HASH=
WEB_SESSION_KEY=

# Provider credentials and IDs: backend only, verify models/voices before enabling.
RESEMBLE_API_KEY=
RESEMBLE_PROJECT_UUID=
RESEMBLE_VOICE_UUID_EN=
RESEMBLE_VOICE_UUID_HI=
RESEMBLE_TTS_MODEL=
GEMINI_API_KEY=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# Optional bounds default to 30s assistant/speech, 15s WhatsApp, 2s d1-ultra; max retries 1.
# Audio is capped at 3 MB / 30 seconds; speech text at 600 characters.
# WHATSAPP_ENABLED defaults false. Configure only approved test recipients.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=
# Private JSON mapping approved sender ID -> user UUID; never print or put in frontend.
WHATSAPP_SENDER_ALLOWLIST_JSON=
# Village pilot: Meta-approved Hindi utility template name for due reminders (optional).
WHATSAPP_REMINDER_TEMPLATE=

# Self-serve sign-up (docs/signup-round/contract.md); stays off until the human enables it.
SIGNUP_ENABLED=false
SIGNUP_LIMIT=100
SESSION_DAYS=30
DAILY_AI_LIMIT=100
DAILY_VOICE_LIMIT=60
# Public values, read by the web app from /api/v1/auth/session: the sign-in-only Google client
# ID (separate from the Gmail client) and the WhatsApp number people message, digits only.
GOOGLE_SIGNIN_CLIENT_ID=
WHATSAPP_PUBLIC_NUMBER=
# Keep false until Google verifies FinBoy's Gmail scopes.
GMAIL_FOR_NEW_ACCOUNTS=false

# Optional transactional email; keep real keys only in private server-side configuration.
RESEND_API_KEY=
